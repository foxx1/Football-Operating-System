{
  "name": "@360fos/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch --exclude uploads server/index.ts",
    "build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "lint": "tsc --noEmit --pretty false",
    "validate": "npm run check && npm test -- --run && npm run build",
    "release:check": "npm run lint && npm test -- --run && npm run build",
    "db:audit": "tsx scripts/audit-data-integrity.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest"
  },
  "dependencies": {
    "@360fos/shared": "*",
    "@aws-sdk/client-s3": "^3.1106.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.39.1",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "memorystore": "^1.6.7",
    "multer": "^2.0.1",
    "pg": "^8.16.3",
    "resend": "^6.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^1.4.13",
    "@types/node": "20.16.11",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.30.4",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "vitest": "4.0.14"
  }
}
