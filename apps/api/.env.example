# ── Database ─────────────────────────────────────────────────────────
# Neon DB connection string (copy from Neon dashboard → Connection string)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Session ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_64_char_random_hex

# ── App URL ───────────────────────────────────────────────────────────
# The public URL of the frontend (apps/app), used in email links
APP_URL=https://app.360fos.com

# ── File Storage: Cloudflare R2 ───────────────────────────────────────
# Set UPLOAD_PROVIDER=object-storage to enable R2.
# Leave as "local" during development.
UPLOAD_PROVIDER=object-storage

# From Cloudflare dashboard → R2 → your bucket → Settings
OBJECT_STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=360fos-uploads

# From Cloudflare R2 → Manage R2 API tokens → Create API token
OBJECT_STORAGE_ACCESS_KEY_ID=your_r2_access_key_id
OBJECT_STORAGE_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Public URL — either r2.dev subdomain or your custom domain on the bucket
OBJECT_STORAGE_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Email: Resend ─────────────────────────────────────────────────────
# Get from resend.com → API Keys
# Without this, password reset emails are only logged to console.
RESEND_API_KEY=re_xxxxxxxxxxxx

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=production
